---
import Layout from '@/layouts/Layout.astro';
import Form from '@/components/FeedbackForm/Form.astro';
import settings from '@/data/settings.json';
import PageH1 from '@/components/PageH1/Index.astro';
const { brand, legal_city_where } = settings;
---

<Layout title={`Запись на сервис ${brand}`} description={`Запись на сервис автомобилей ${brand} в ${legal_city_where}`}>
	<div class="container py-10 space-y-10">
		<div>
			<PageH1 h1={`Записаться на сервис ${brand}`} classes="text-3xl sm:text-4xl font-bold text-center" />
			<p class="text-center mt-1 text-gray-500">Профессиональное обслуживание с сохранением гарантии</p>
		</div>
		<div class="flex flex-col-reverse lg:grid grid-cols-2 items-center gap-10">
			<Form dataFormName="Запись на сервис" showModelSelect={true} />
			<img src="https://cdn.alexsab.ru/b/livan/img/banners/moyka-dnishcha.webp" alt="Мойка днища на подъемнике">
		</div>
	</div>
</Layout>